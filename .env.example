# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database
MONGODB_URI=mongodb://localhost:27017/admin_panel
DB_NAME=admin_panel

# JWT Secret
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRE=7d

# Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# API Settings
API_PREFIX=/api/v1
MAX_JSON_SIZE=10mb
